# Initial Linux terminal profile for the Phase 0 compatibility spike.
corvid|xterm-corvid-256color|Corvid bounded VT profile,
    am, bce, Tc,
    colors#256, cols#80, lines#24, pairs#32767,
    cr=^M, ind=^J,
    clear=\E[H\E[2J, el=\E[K, ed=\E[J,
    cup=\E[%i%p1%d;%p2%dH, home=\E[H,
    cub1=^H, cud1=\E[B, cuf1=\E[C, cuu1=\E[A,
    csr=\E[%i%p1%d;%p2%dr,
    civis=\E[?25l, cnorm=\E[?25h,
    bold=\E[1m, rev=\E[7m, smul=\E[4m, rmul=\E[24m, sgr0=\E[0m,
    setaf=\E[38;5;%p1%dm, setab=\E[48;5;%p1%dm, op=\E[39;49m,
    smcup=\E[?1049h, rmcup=\E[?1049l,
    smkx=\E[?1h\E=, rmkx=\E[?1l\E>,
    kbs=\177, kcub1=\EOD, kcud1=\EOB, kcuf1=\EOC, kcuu1=\EOA,
